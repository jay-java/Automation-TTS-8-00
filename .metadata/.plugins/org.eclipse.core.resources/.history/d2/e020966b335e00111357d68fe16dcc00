package core;

//poly -> many
//morphism -> forms
class Overload {
	public int add(int i, int j) {
		return i + j;
	}

	public int add(int i, int j, int k) {
		return i + j + k;
	}

	public double add(double i, int j) {
		return i + j;
	}
}

class Parent {
	public void call() {
		System.out.println("call in parent class");
	}
}
class Child{
	
}

public class P015_Polymorphism {
	public static void main(String[] args) {
		Overload o = new Overload();
		int res1 = o.add(12, 34);
		System.out.println(res1);

		double res2 = o.add(4235.45, 4356);
		System.out.println(res2);
	}
}
